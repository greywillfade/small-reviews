{% include "partials/base.njk" %}
{% include "partials/headerintro.njk" %}

    <div class="highlights-bar">
      <div>
        <strong>Year's Highlights</strong>
        <ul>
            <li>🎮 <a href="/2024/#Game2024-04-03">Chants of Sennar</a> and <a href="/2024/#Game2024-01-27">Gris</a></li>
            <li>📖 <a href="/2024/#Book2024-02-14">Silo saga re-read</a></li>
            <li>📖 <a href="/2024/#Book2024-07-24">Matrescence</a></li>
            <li>📖 <a href="/2024#Book2024-05-23">Some Desperate Glory</a></li>
        </ul>
      </div>
    </div>

    <div class="section-head">
        <h2>2024 entries</h2>
    </div>

    <div class="entries">

        {%- for review in collections[2024] | reverse -%}
            <article id='{{ review.data.category }}{{ review.data.date }}' class="entry is-{{- review.data.category | lower -}}">
            <div class="entry-aside">
                <div class="type-icon">{%- if (review.data.category == "Book") -%}<span role="img" aria-label="Open book">📖</span>{%- else -%}<span role="img" aria-label="Game controller">🎮</span>{%- endif -%}</div>
                
                <div class="entry-stars stars stars--{{- review.data.category | lower -}}" style="--rating: {{- review.data.rating -}}"></div>
            </div>
            <div class="entry-content">
                <div class="entry-label">{%- if (review.data.category == "Book") -%}Book{%- else -%}Game{%- endif -%}</div>
                <h2 class="entry-title">{%- if (review.data.category == "Book") -%}{{ review.data.title }} by {{ review.data.author -}}{%- else -%}{{ review.data.title -}}{%- endif -%}</h2>
                <div class="entry-date">Finished {{ review.data.dateFinished -}}</div>
                <div class="entry-body">{{- review.content | safe -}}</div>
            </div>
            </article>
        {%- endfor -%}

{% include "partials/footer.njk" %}